PORT=3000
DATABASE_URL=
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Clerk Dashboard → Webhooks → Signing secret (whsec_...). Required for POST /webhooks/clerk
CLERK_WEBHOOK_SECRET=
OPENAI_API_KEY=sk-...
OPENAI_MODEL=
OPENAI_MAX_TOKENS_GENERATE=4096
OPENAI_MAX_TOKENS_EXPLAIN=800
OPENAI_MAX_TOKENS_OCR=2048
AI_DAILY_GENERATE_LIMIT=20
AI_DAILY_EXPLAIN_LIMIT=60
AI_DAILY_OCR_LIMIT=15
# Dev may use *. Production MUST set an explicit allowlist (never *).
CORS_ORIGIN=*
# Interactive OpenAPI UI at /api-docs (and /openapi.json). Defaults on when
# NODE_ENV !== production. Set true to force-enable in production (not recommended).
# ENABLE_API_DOCS=true

# Optional JWT azp allowlist (comma-separated). Leave unset for native apps —
# guessing azp causes 401 "Please sign in again." When set, Frontend API origin
# from CLERK_PUBLISHABLE_KEY is also allowed.
# CLERK_AUTHORIZED_PARTIES=https://your-app.example.com
