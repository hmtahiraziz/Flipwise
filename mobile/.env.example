# ── Development (emulator / local API) ──────────────────────────────────────
API_BASE_URL=http://10.0.2.2:3000
# iOS simulator:
# API_BASE_URL=http://localhost:3000

CLERK_PUBLISHABLE_KEY="pk_test_..."

# Optional — defaults to https://flipwise.app (must serve /privacy and /terms)
# LEGAL_BASE_URL=https://flipwise.app

# ── Production (Play Store release) ─────────────────────────────────────────
# Before `npm run android:bundle`, replace .env with production values:
#
# API_BASE_URL=https://api.your-domain.com
# CLERK_PUBLISHABLE_KEY="pk_live_..."
# LEGAL_BASE_URL=https://flipwise.app
#
# Or copy this file to .env.production and run:
#   $env:ENVFILE=".env.production"; npm run android:bundle
#
# Checklist:
# - HTTPS API (no localhost / 10.0.2.2)
# - Clerk pk_live_ key + production native app + OAuth redirect flipwise://oauth-native-callback
# - Public Privacy Policy URL reachable (Play Console + in-app links)
